# =========================================
# VERSION PHP
# =========================================
AddHandler application/x-httpd-php84 .php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Ne pas reboucler si déjà dans /public/
    RewriteCond %{REQUEST_URI} !^/public/

    # Rediriger TOUT (y compris la racine /) vers public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
